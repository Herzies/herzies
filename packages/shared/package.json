{
  "name": "@herzies/shared",
  "version": "0.6.1",
  "type": "module",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",
  "exports": {
    ".": {
      "import": "./dist/index.js",
      "require": "./dist/index.js",
      "types": "./dist/index.d.ts"
    },
    "./theme.css": "./theme.css",
    "./server": {
      "import": "./dist/game-server.js",
      "require": "./dist/game-server.js",
      "types": "./dist/game-server.d.ts"
    },
    "./game-events": {
      "import": "./dist/game-events.js",
      "require": "./dist/game-events.js",
      "types": "./dist/game-events.d.ts"
    },
    "./town-net": {
      "types": "./dist/town-net.d.ts",
      "import": "./dist/town-net.js",
      "require": "./dist/town-net.js"
    },
    "./gl": {
      "types": "./dist/gl/index.d.ts",
      "import": "./dist/gl/index.js",
      "require": "./dist/gl/index.js"
    },
    "./card-art/*": "./card-art/*"
  },
  "files": [
    "dist",
    "theme.css",
    "card-art"
  ],
  "scripts": {
    "build": "tsc",
    "check": "tsc --noEmit",
    "dev": "tsc --watch",
    "test": "vitest run"
  },
  "peerDependencies": {
    "@supabase/supabase-js": "^2",
    "react": ">=19",
    "three": ">=0.186"
  },
  "devDependencies": {
    "@supabase/supabase-js": "^2.105.1",
    "@types/node": "^25.6.0",
    "@types/react": "^19.2.14",
    "@types/three": "^0.186.0",
    "react": "^19.2.5",
    "three": "^0.186.1",
    "typescript": "^6.0.3"
  },
  "peerDependenciesMeta": {
    "@supabase/supabase-js": {
      "optional": true
    },
    "three": {
      "optional": true
    }
  }
}
